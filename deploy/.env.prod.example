# Bí mật production — chép thành .env.prod, KHÔNG commit. Sinh ngẫu nhiên:
#   openssl rand -base64 48        (mật khẩu / khoá)
#   openssl rand -base64 756       (MONGO_REPLICA_KEY)

DOMAIN=thiephy.sunriseieco.vn
MEDIA_DOMAIN=media.thiephy.sunriseieco.vn

# --- Ứng dụng (đọc bởi API) ---
JWT_SECRET=
SUPPORT_ZALO_PHONE=
SUPPORT_ZALO_NAME=Tư vấn Xưởng Thiệp Hỷ
ONLINE_PAYMENT_ENABLED=false
# Chỉ khi bật thanh toán online: khoá riêng >= 32 ký tự, MoMo cổng thật.
BANK_WEBHOOK_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
# --- Apple In-App Purchase (StoreKit 2) -----------------------------------
APPLE_IAP_BUNDLE_ID=vn.sunriseieco.thiepHy
APPLE_IAP_APPLE_ID=6817227927
APPLE_IAP_STANDARD_PRODUCT_ID=vn.sunriseieco.thiephy.plan.standard
APPLE_IAP_PREMIUM_PRODUCT_ID=vn.sunriseieco.thiephy.plan.premium
APPLE_IAP_ENABLE_ONLINE_CHECKS=true
# Gợi ý câu chữ bằng AI (trống = tắt). Đặt hạn mức chi tiêu ở Anthropic Console.
ANTHROPIC_API_KEY=
# Theo dõi lỗi (tuỳ chọn). Trống = tắt.
SENTRY_DSN=
APP_RELEASE=
UVICORN_WORKERS=4

# --- Hạ tầng ---
MONGO_ROOT_USER=wedding
MONGO_ROOT_PASSWORD=
MONGO_REPLICA_KEY=
REDIS_PASSWORD=
S3_ACCESS_KEY=wedding-prod
S3_SECRET_KEY=
S3_BUCKET=wedding-media
