# Bí mật production — chép thành .env.prod, KHÔNG commit. Sinh ngẫu nhiên:
#   openssl rand -base64 48        (mật khẩu / khoá)
#   openssl rand -base64 756       (MONGO_REPLICA_KEY)

DOMAIN=thiephy.vn
MEDIA_DOMAIN=media.thiephy.vn

# --- Ứng dụng (đọc bởi API) ---
JWT_SECRET=
SUPPORT_ZALO_PHONE=
SUPPORT_ZALO_NAME=Tư vấn Xưởng Thiệp Hỷ
ONLINE_PAYMENT_ENABLED=false
# Chỉ khi bật thanh toán online: khoá riêng >= 32 ký tự, MoMo cổng thật.
BANK_WEBHOOK_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
# Gợi ý câu chữ bằng AI (trống = tắt). Đặt hạn mức chi tiêu ở Anthropic Console.
ANTHROPIC_API_KEY=
# Theo dõi lỗi (tuỳ chọn). Trống = tắt.
SENTRY_DSN=
APP_RELEASE=
UVICORN_WORKERS=4

# --- Hạ tầng ---
MONGO_ROOT_USER=wedding
MONGO_ROOT_PASSWORD=
MONGO_REPLICA_KEY=
REDIS_PASSWORD=
S3_ACCESS_KEY=wedding-prod
S3_SECRET_KEY=
S3_BUCKET=wedding-media
