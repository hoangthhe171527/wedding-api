# ---------------------------------------------------------------------------
# wedding-api — biến môi trường. Giá trị dưới đây là GIÁ TRỊ MẪU cho local,
# không phải bí mật thật. `JWT_SECRET` mẫu bị từ chối ngoài local/test.
# ---------------------------------------------------------------------------
ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# docker-compose.yml đã đặt sẵn MONGODB_URL / REDIS_URL cho mạng nội bộ.
# MONGODB_URL=mongodb://localhost:28017/?replicaSet=rs0&directConnection=true
# REDIS_URL=redis://localhost:28379/0

JWT_SECRET=doi-chuoi-nay-truoc-khi-len-that-toi-thieu-32-ky-tu
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30

# Địa chỉ công khai: dựng link web thiệp và URL ảnh trả cho trình duyệt.
PUBLIC_WEB_URL=http://localhost:8091
PUBLIC_API_URL=http://localhost:28080

# Cho phép khách tự đăng ký tài khoản dùng mẫu.
ALLOW_SELF_REGISTRATION=true

# Nạp tài khoản demo khi khởi động (chỉ chạy ở ENV=local).
AUTO_SEED=true

# Danh sách origin cho CORS (ngoài local). Local tự cho mọi cổng localhost.
# CORS_ORIGINS=https://thiep.example.vn

# --- Thanh toán -------------------------------------------------------------
# Giả lập thanh toán: web hiện nút "Giả lập đã chuyển khoản". CHỈ local/test.
PAYMENT_SANDBOX=true
# Tài khoản nhận chuyển khoản VietQR (BIN 6 số của ngân hàng, ví dụ 970436 = Vietcombank).
# BANK_BIN=970436
# BANK_NAME=Vietcombank
# BANK_ACCOUNT_NO=0123456789
# BANK_ACCOUNT_NAME=CONG TY THIEP HY
# Khoá dịch vụ đọc sao kê gửi kèm webhook: "Authorization: Apikey <khoá>".
BANK_WEBHOOK_KEY=local-dev-webhook-key
# Ví MoMo — để trống là tắt.
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY=
# MOMO_SECRET_KEY=
# MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# --- Apple In-App Purchase (StoreKit 2) -----------------------------------
# Bundle ID và product IDs phải trùng App Store Connect.
APPLE_IAP_BUNDLE_ID=vn.sunriseieco.thiepHy
# App Store ID dạng số; để trống khi chỉ chạy local/sandbox.
APPLE_IAP_APPLE_ID=
APPLE_IAP_STANDARD_PRODUCT_ID=vn.sunriseieco.thiephy.plan.standard
APPLE_IAP_PREMIUM_PRODUCT_ID=vn.sunriseieco.thiephy.plan.premium
APPLE_IAP_ENABLE_ONLINE_CHECKS=true

# Gợi ý câu chữ thiệp bằng Claude. Để trống = tắt tính năng.
ANTHROPIC_API_KEY=
AI_WORDING_MODEL=claude-opus-5

# Kho object S3 cho ảnh cưới (SeaweedFS ở local). docker-compose local đã cấp sẵn.
# Prod: xem deploy/README.md — SeaweedFS tự host hoặc Cloudflare R2 / AWS S3.
S3_ENDPOINT=http://s3:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=wedding-media
# Domain công khai của kho / CDN: có thì ảnh tải thẳng từ kho, API không gánh byte.
S3_PUBLIC_URL=

# Theo dõi lỗi (tuỳ chọn): trống = tắt.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
APP_RELEASE=
